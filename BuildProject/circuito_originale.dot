graph Circuito {
    // Stile dei nodi e degli archi
    node [shape=circle, style=filled, fillcolor=lightblue, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];

    1 -- 2 [label="V1\n12.5 V"];
    1 -- 3 [label="R1\n30.8 Ohm", color="red", fontcolor="red"];
    2 -- 3 [label="V2\n10 V"];
    3 -- 6 [label="R4\n7 Ohm"];
    5 -- 6 [label="V3\n5 V"];
    5 -- 7 [label="R3\n8 Ohm", color="red", fontcolor="red"];
    6 -- 7 [label="R2\n6 Ohm"];
}
