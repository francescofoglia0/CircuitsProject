graph Circuito {
    // Stile dei nodi e degli archi
    node [shape=circle, style=filled, fillcolor=lightblue, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];

    1 -- 2 [label="\n1 Ohm"];
    1 -- 5 [label="\n1 Ohm"];
    3 -- 4 [label="\n1 Ohm", color="red", fontcolor="red"];
    4 -- 8 [label="\n1 Ohm", color="red", fontcolor="red"];
    5 -- 6 [label="\n1 Ohm"];
    5 -- 9 [label="\n1 Ohm"];
    7 -- 10 [label="\n1 Ohm", color="red", fontcolor="red"];
    8 -- 12 [label="\n1 Ohm", color="red", fontcolor="red"];
    9 -- 10 [label="\n1 Ohm"];
    10 -- 11 [label="\n1 Ohm"];
    11 -- 12 [label="\n1 Ohm"];
}
