graph Circuito {
    // Stile dei nodi e degli archi
    node [shape=circle, style=filled, fillcolor=lightblue, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];

    1 -- 2 [label="\n1 Ohm", color="red", fontcolor="red"];
    1 -- 4 [label="\n1 Ohm"];
    2 -- 4 [label="\n1 Ohm", color="red", fontcolor="red"];
}
