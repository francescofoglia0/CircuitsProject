graph Circuito {
    // Stile dei nodi e degli archi
    node [shape=circle, style=filled, fillcolor=lightblue, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];

    1 -- 2 [label="R2\n10 Ohm"];
    1 -- 3 [label="R3\n30 Ohm"];
    1 -- 4 [label="V1\n30 V"];
    2 -- 3 [label="R4\n10 Ohm", color="red", fontcolor="red"];
    2 -- 4 [label="R1\n4 Ohm", color="red", fontcolor="red"];
    2 -- 5 [label="R5\n4 Ohm"];
    3 -- 5 [label="V2\n40 V"];
}
