graph Circuito {
    // Stile dei nodi e degli archi
    node [shape=circle, style=filled, fillcolor=lightblue, fontname="Helvetica"];
    edge [fontname="Helvetica", fontsize=10];

    1 -- 2 [label="R1\n10 Ohm"];
    1 -- 5 [label="R9\n5 Ohm"];
    2 -- 3 [label="V1\n12 V"];
    2 -- 5 [label="R15\n10 Ohm"];
    2 -- 6 [label="R10\n8 Ohm"];
    3 -- 4 [label="R2\n10 Ohm"];
    3 -- 6 [label="R16\n10 Ohm"];
    3 -- 7 [label="R11\n12 Ohm"];
    4 -- 8 [label="R12\n5 Ohm"];
    5 -- 6 [label="R3\n15 Ohm"];
    5 -- 9 [label="V2\n50 V"];
    6 -- 7 [label="R4\n25 Ohm"];
    6 -- 9 [label="R17\n15 Ohm"];
    6 -- 10 [label="R13\n8 Ohm"];
    6 -- 11 [label="R19\n22 Ohm"];
    7 -- 8 [label="R5\n15 Ohm"];
    7 -- 10 [label="R18\n15 Ohm"];
    7 -- 11 [label="R14\n12 Ohm"];
    8 -- 12 [label="V3\n24 V"];
    9 -- 10 [label="R6\n10 Ohm"];
    10 -- 11 [label="R7\n20 Ohm"];
    11 -- 12 [label="R8\n10 Ohm"];
}
